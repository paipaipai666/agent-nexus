Screen {
    layout: vertical;
}

#top-bar {
    height: 2;
}

#middle {
    height: 1fr;
    layout: horizontal;
}

#chat-area {
    width: 1fr;
    height: 100%;
    padding: 1 2 0 2;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

#side-panel {
    display: none;
    width: 38;
    height: 100%;
    border-left: solid $foreground 20%;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#hud {
    height: 2;
}

.has-inspector #side-panel {
    display: block;
}

#welcome {
    height: auto;
    padding: 0 0 1 0;
}

#new-output {
    height: 1;
    min-width: 0;
    width: 100%;
    border: none;
    background: $surface;
    color: $primary;
    padding: 0;
}

#task-strip {
    height: 1;
    padding: 0 2;
    background: $surface;
}

#task-summary {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#task-strip Button {
    height: 1;
    min-width: 6;
    width: 6;
    border: none;
    padding: 0;
    background: transparent;
    color: $text-muted;
}

#command-palette {
    display: none;
    height: auto;
    max-height: 10;
    padding: 0 2;
    background: $surface;
    border-top: solid $foreground 20%;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

#command-palette-content {
    width: 100%;
    height: auto;
}

#input-area {
    height: 5;
}
