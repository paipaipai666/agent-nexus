#input-area { height: 5; padding: 0 1; border-top: solid $foreground 20%; }
#composer-meta { height: 1; color: $text-muted; padding: 0 2; text-wrap: nowrap; text-overflow: ellipsis; }
#input-row { height: 1; }
#input-prompt { width: 2; height: 1; color: $primary; text-style: bold; }
#chat-input { width: 1fr; height: 1; padding: 0; border: none; background: transparent; color: $foreground; }
#chat-input:focus { border: none; }
#composer-hints { height: 1; padding: 0 2; color: $text-muted; text-wrap: nowrap; text-overflow: ellipsis; }
