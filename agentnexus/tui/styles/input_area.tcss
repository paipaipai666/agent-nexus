#input-area { height: auto; padding: 0 2; border-top: solid $foreground; }
#composer-meta { height: 1; color: $text-muted; padding: 0 2; text-wrap: nowrap; text-overflow: ellipsis; }
#input-row { height: auto; }
#input-prompt { width: 2; height: 1; color: $primary; text-style: bold; }
#chat-input { width: 1fr; height: 1; min-height: 1; max-height: 6; padding: 0; border: none; background: transparent; color: $foreground; scrollbar-size-vertical: 1; }
#chat-input:focus { border: none; }
Composer .text-area--placeholder { color: $text-muted; }
#composer-footer { height: 1; }
#composer-hints { text-align: right; height: 1; width: 1fr; color: $text-muted; text-wrap: nowrap; text-overflow: ellipsis; }
