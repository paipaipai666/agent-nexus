#input-area { height: auto; padding: 0 2; }
#composer-actions { height: 1; }
#composer-actions Button { height: 1; width: auto; min-width: 6; max-width: 30; border: none; padding: 0 1; background: transparent; color: $text-muted; text-overflow: ellipsis; }
#composer-actions Button:hover, #composer-actions Button:focus { color: $primary; background: $primary 8%; }
#composer-actions #choose-model { width: 1fr; min-width: 8; max-width: 40; }
#composer-meta { height: 1; color: $text-muted; padding: 0 2; text-wrap: nowrap; text-overflow: ellipsis; }
#input-row { height: auto; }
#input-prompt { width: 2; height: 1; color: $primary; text-style: bold; }
#chat-input { width: 1fr; height: 1; min-height: 1; max-height: 6; padding: 0; border: none; background: transparent; color: $foreground; scrollbar-size-vertical: 1; }
#chat-input:focus { border: none; }
Composer .text-area--placeholder { color: $text-muted; }
#composer-footer { height: 1; }
#composer-hints { height: 1; width: auto; max-width: 70%; color: $text-muted; text-wrap: nowrap; text-overflow: ellipsis; }
