Screen {
    background: $background;
    color: $foreground;
}
Scrollbar {
    background: transparent;
    color: $foreground 35%;
}
Scrollbar:hover {
    color: $primary;
}
LoadingIndicator {
    color: $primary;
}
Widget {
    background: transparent;
}

ContextFooter {
    link-style: none;
    link-color: $text-muted;
    link-background: transparent;
    link-style-hover: bold;
    link-color-hover: $primary;
}
