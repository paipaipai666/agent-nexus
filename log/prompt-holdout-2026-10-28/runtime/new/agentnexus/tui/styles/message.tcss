ChatMessage { width: 100%; max-width: 100; height: auto; padding: 0; margin: 0 0 1 0; border-left: blank $foreground; }
ChatMessage.user { color: $foreground; }
.request-line { height: auto; }
.request-marker { width: 2; height: 1; color: $primary; text-style: bold; }
ChatMessage.user #msg-content { width: 1fr; }
ChatMessage.assistant, ChatMessage.system { padding: 0 0 0 2; }
ChatMessage.system { color: $text-muted; }
ChatArea:focus .record-selected, ChatArea:focus-within .record-selected { border-left: solid $primary; }
#msg-content { height: auto; }
.msg-text, .msg-code, .msg-reaction { height: auto; }
.msg-code { padding: 0 1; }
ToolCall { width: 100%; max-width: 100; height: auto; padding: 0; margin: 0 0 1 0; border-left: blank $foreground; }
ToolCall:focus { border-left: solid $primary; }
#tool-name { height: 1; width: 100%; color: $text-muted; text-overflow: ellipsis; text-wrap: nowrap; }
#tool-result { height: auto; padding: 0 0 0 2; color: $foreground; }
